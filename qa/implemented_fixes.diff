+        // "someting" vs "something" is still obviously the same word.
+        final allowed = word.length >= 8 ? 2 : 1;
+        if (distance >= 1 &&
+            distance <= allowed &&
+            distance < bestDistance &&
+            search(candidate).isNotEmpty) {
+          best = candidate;
+          bestDistance = distance;
+        }
+      }
+    }
+    return best;
+  }
