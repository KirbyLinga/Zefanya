diff --git a/mobile/test/store_follow_test.dart b/mobile/test/store_follow_test.dart
new file mode 100644
index 0000000..2f94914
--- /dev/null
+++ b/mobile/test/store_follow_test.dart
@@ -0,0 +1,129 @@
+// test/store_follow_test.dart
+//
+// Following a shop is a buyer action with its own state: it is not the same as
+// hearting a product, and unfollowing must remove it from the following list,
+// not just change a button label.
+//
+// The state tests pin persistence; the widget tests pin the two places the
+// result is visible (seller hero and Saved screen) so a future refactor cannot
+// leave the count and the list disagreeing.
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:google_fonts/google_fonts.dart';
+import 'package:provider/provider.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:zefanya/screens/buyer/saved_screen.dart';
+import 'package:zefanya/screens/buyer/seller_screen.dart';
+import 'package:zefanya/state/catalog_state.dart';
+import 'package:zefanya/state/wishlist_state.dart';
+import 'package:zefanya/theme/app_theme.dart';
+
+const _seller = 'Willow & Bloom Atelier';
+
+Future<void> _pump(
+  WidgetTester tester,
+  Widget child, {
+  WishlistState? wishlist,
+}) async {
+  AppColors.apply(Brightness.light);
+  GoogleFonts.config.allowRuntimeFetching = false;
+  tester.view.physicalSize = const Size(390, 844);
+  tester.view.devicePixelRatio = 1.0;
+  addTearDown(tester.view.reset);
+
+  final catalog = CatalogState();
+  await catalog.load();
+
+  await tester.pumpWidget(
+    MultiProvider(
+      providers: [
+        ChangeNotifierProvider.value(value: catalog),
+        ChangeNotifierProvider(create: (_) => wishlist ?? WishlistState()),
+      ],
+      child: MaterialApp(
+        theme: AppTheme.light,
+        home: MediaQuery(
+          data: const MediaQueryData(
+            size: Size(390, 844),
+            disableAnimations: true,
+          ),
+          child: child,
+        ),
+      ),
+    ),
+  );
+  await tester.pump(const Duration(milliseconds: 100));
+}
+
+void main() {
+  setUp(() {
+    SharedPreferences.setMockInitialValues({});
+  });
+
+  group('follow state', () {
+    test('follow/unfollow moves the shop in and out of the list', () async {
+      final state = WishlistState();
+      expect(state.isFollowing(_seller), isFalse);
+
+      expect(state.toggleFollow(_seller), isTrue);
+      expect(state.isFollowing(_seller), isTrue);
+      expect(state.followedSellers, [_seller]);
+
+      // Following twice is a toggle, not a duplicate.
+      expect(state.toggleFollow(_seller), isFalse);
+      expect(state.isFollowing(_seller), isFalse);
+      expect(state.followedSellers, isEmpty);
+    });
+
+    test('followed shops survive a restart', () async {
+      final state = WishlistState();
+      state.toggleFollow(_seller);
+      await pumpEventQueue();
+
+      final restarted = WishlistState();
+      await restarted.load();
+
+      expect(restarted.isFollowing(_seller), isTrue);
+      expect(restarted.followedSellers, [_seller]);
+    });
+
+    test('following does not affect the product wishlist', () async {
+      final state = WishlistState();
+      state.toggle(_seller);
+      state.toggleFollow(_seller);
+
+      expect(state.followedSellers, [_seller]);
+      expect(state.items, isEmpty);
+    });
+  });
+
+  group('where following shows', () {
+    testWidgets('seller hero toggles Follow to Following', (tester) async {
+      final wishlist = WishlistState();
+      await _pump(
+        tester,
+        const SellerScreen(sellerName: _seller),
+        wishlist: wishlist,
+      );
+
+      expect(find.text('Follow'), findsOneWidget);
+      await tester.tap(find.byKey(const ValueKey('follow-seller')));
+      await tester.pump();
+
+      expect(find.text('Following'), findsOneWidget);
+      expect(wishlist.isFollowing(_seller), isTrue);
+      expect(tester.takeException(), isNull);
+    });
+
+    testWidgets('Saved lists the followed shop with its count',
+        (tester) async {
+      final wishlist = WishlistState()..toggleFollow(_seller);
+      await _pump(tester, const SavedScreen(), wishlist: wishlist);
+
+      expect(find.text('STORES YOU FOLLOW · 1'), findsOneWidget);
+      expect(find.text(_seller), findsOneWidget);
+      expect(tester.takeException(), isNull);
+    });
+  });
+}
diff --git a/mobile/test/validators_test.dart b/mobile/test/validators_test.dart
new file mode 100644
index 0000000..9433dbc
--- /dev/null
+++ b/mobile/test/validators_test.dart
@@ -0,0 +1,104 @@
+// test/validators_test.dart
+//
+// The field rules shared by registration and Edit Profile. These are the
+// rules a widget test can only prove indirectly; here they are pinned
+// directly, including the boundary values the workbook uses.
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:zefanya/utils/validators.dart';
+
+void main() {
+  group('person names (A2)', () {
+    test('empty and one-character names are refused', () {
+      expect(
+        validatePersonName('', label: 'First name'),
+        'First name is required',
+      );
+      expect(
+        validatePersonName('  ', label: 'First name'),
+        'First name is required',
+      );
+      expect(validatePersonName('J', label: 'First name'), isNotNull);
+    });
+
+    test('2 and 50 characters are accepted; 51 is not', () {
+      final fifty = List.filled(50, 'a').join();
+      final fiftyOne = List.filled(51, 'a').join();
+      expect(validatePersonName('Jo', label: 'First name'), isNull);
+      expect(validatePersonName(fifty, label: 'First name'), isNull);
+      expect(validatePersonName(fiftyOne, label: 'First name'), isNotNull);
+    });
+
+    test('letters, spaces, hyphen, apostrophe, period and ñ survive', () {
+      for (final name in [
+        'Dela Cruz',
+        'Maria-Jose',
+        "O'Neil",
+        'St. John',
+        'Peña',
+        'Ñico',
+      ]) {
+        expect(
+          validatePersonName(name, label: 'First name'),
+          isNull,
+          reason: name,
+        );
+      }
+    });
+
+    test('numbers and other symbols are refused', () {
+      for (final name in ['Juan2', 'Juan@', 'Juan_', 'Juan#']) {
+        expect(
+          validatePersonName(name, label: 'First name'),
+          isNotNull,
+          reason: name,
+        );
+      }
+    });
+  });
+
+  group('password (A5)', () {
+    test('below eight characters gets the length message', () {
+      expect(validatePassword('Aa1!aa'), 'Use at least 8 characters');
+    });
+
+    test('each missing character class is refused', () {
+      expect(validatePassword('lowercase1!'), isNotNull); // no uppercase
+      expect(validatePassword('UPPERCASE1!'), isNotNull); // no lowercase
+      expect(validatePassword('NoNumber!!'), isNotNull); // no digit
+      expect(validatePassword('NoSymbol11'), isNotNull); // no symbol
+    });
+
+    test('eight characters with all four classes pass', () {
+      expect(validatePassword('Abcdef1!'), isNull);
+    });
+
+    test('spaces are refused', () {
+      expect(validatePassword('Abc def1!'), isNotNull);
+    });
+  });
+
+  group('age (A6)', () {
+    test('the 18th birthday counts, the day before does not', () {
+      final today = DateTime(2026, 10, 21);
+      expect(
+        isAtLeastYearsOld(DateTime(2008, 10, 21), 18, today: today),
+        isTrue,
+      );
+      expect(
+        isAtLeastYearsOld(DateTime(2008, 10, 22), 18, today: today),
+        isFalse,
+      );
+      expect(ageOn(DateTime(2008, 10, 22), today: today), 17);
+    });
+
+    test('a 17-year-old is refused and an 18-year-old accepted', () {
+      final today = DateTime(2026, 10, 21);
+      expect(
+        isAtLeastYearsOld(DateTime(2009, 1, 1), 18, today: today),
+        isFalse,
+      );
+      expect(isAtLeastYearsOld(DateTime(2008, 1, 1), 18, today: today), isTrue);
+    });
+  });
+}
